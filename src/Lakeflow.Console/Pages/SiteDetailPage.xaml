<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lakeflow.Console.Pages.SiteDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lakeflow.Console"
    xmlns:vm="using:Lakeflow.Console.Core.ViewModels"
    xmlns:c="using:Lakeflow.Contracts">
    <ScrollViewer>
        <StackPanel Spacing="16">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <TextBlock Text="{x:Bind ViewModel.Site.Name, Mode=OneWay}" Style="{StaticResource TitleTextBlockStyle}" />
                <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" />
                <Button Content="Refresh" Command="{x:Bind ViewModel.LoadCommand}" />
                <Button Content="Add source" Click="OnAddSource" Visibility="{x:Bind local:Ui.Show(ViewModel.CanAdminister)}" />
                <Button Content="Collect logs" Command="{x:Bind ViewModel.CollectLogsCommand}" Visibility="{x:Bind local:Ui.Show(ViewModel.CanAdminister)}" />
                <Button Content="Restart agent" Command="{x:Bind ViewModel.RestartCommand}" Visibility="{x:Bind local:Ui.Show(ViewModel.CanAdminister)}" />
            </StackPanel>

            <InfoBar IsOpen="True" Severity="Error" Title="Problem" Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowText(ViewModel.Error), Mode=OneWay}" />
            <InfoBar IsOpen="True" Severity="Informational" Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                     Visibility="{x:Bind local:Ui.ShowText(ViewModel.Message), Mode=OneWay}" />

            <!-- Agent -->
            <Grid ColumnSpacing="32">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Agent" Opacity="0.6" />
                    <TextBlock Text="{x:Bind ViewModel.Agent.AgentId, Mode=OneWay, FallbackValue='not enrolled'}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Version" Opacity="0.6" />
                    <TextBlock Text="{x:Bind ViewModel.Agent.AgentVersion, Mode=OneWay, FallbackValue='—'}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Host" Opacity="0.6" />
                    <TextBlock Text="{x:Bind ViewModel.Agent.Hostname, Mode=OneWay, FallbackValue='—'}" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Health" Opacity="0.6" />
                    <TextBlock Text="{x:Bind local:Ui.Join(ViewModel.Status.Reasons), Mode=OneWay, FallbackValue='All tables streaming.'}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <!-- Tables -->
            <TextBlock Text="Tables" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Tables}" SelectionMode="None">
                <ListView.Header>
                    <Grid Padding="12,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                            <ColumnDefinition Width="80" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Table" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="State" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Method" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Lag" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Rows/min" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="5" Text="Last night's check" FontWeight="SemiBold" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TableRow">
                        <Grid Padding="0,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="80" />
                                <ColumnDefinition Width="80" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{x:Bind Table}" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind SourceId}" Opacity="0.6" />
                                <TextBlock Text="{x:Bind Error}" Foreground="{StaticResource HealthRed}" TextWrapping="Wrap" Visibility="{x:Bind local:Ui.ShowText(Error)}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{x:Bind State}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Method}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Lag}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind RowsPerMinute}" />
                            <TextBlock Grid.Column="5" Text="{x:Bind ReconciliationText}" TextWrapping="Wrap" />
                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4">
                                <Button Content="Pause" Tag="{x:Bind}" Click="OnPause" Visibility="{x:Bind local:Ui.Hide(IsPaused)}" />
                                <Button Content="Resume" Tag="{x:Bind}" Click="OnResume" Visibility="{x:Bind local:Ui.Show(IsPaused)}" />
                                <Button Content="Resnapshot" Tag="{x:Bind}" Click="OnResnapshot" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Recent commands -->
            <TextBlock Text="Recent commands" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Commands}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="c:CommandDto">
                        <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,4">
                            <TextBlock Text="{x:Bind local:Ui.Time(IssuedUtc)}" Width="200" />
                            <TextBlock Text="{x:Bind local:Ui.Text(Type)}" Width="140" />
                            <TextBlock Text="{x:Bind Table}" Width="160" />
                            <TextBlock Text="{x:Bind IssuedBy}" Width="220" />
                            <TextBlock Text="{x:Bind Result}" TextWrapping="Wrap" MaxWidth="420" />
                            <HyperlinkButton Content="Download logs" Tag="{x:Bind}" Click="OnDownloadLogs" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Recent events -->
            <TextBlock Text="Recent events" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView ItemsSource="{x:Bind ViewModel.Events}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="c:AgentEventDto">
                        <StackPanel Orientation="Horizontal" Spacing="16" Padding="0,4">
                            <TextBlock Text="{x:Bind local:Ui.Time(Event.OccurredUtc)}" Width="200" />
                            <TextBlock Text="{x:Bind local:Ui.Text(Event.Severity)}" Width="80" />
                            <TextBlock Text="{x:Bind Event.Table}" Width="160" />
                            <TextBlock Text="{x:Bind Event.Message}" TextWrapping="Wrap" MaxWidth="700" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </ScrollViewer>
</Page>
