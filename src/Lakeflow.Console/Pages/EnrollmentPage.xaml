<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lakeflow.Console.Pages.EnrollmentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lakeflow.Console">
    <StackPanel Spacing="12" MaxWidth="720" HorizontalAlignment="Left">
        <TextBlock Text="Sites and enrollment" Style="{StaticResource TitleTextBlockStyle}" />
        <TextBox Header="Site id (e.g. stmarys)" Text="{x:Bind ViewModel.SiteId, Mode=TwoWay}" />
        <TextBox Header="Name" Text="{x:Bind ViewModel.SiteName, Mode=TwoWay}" />
        <TextBox Header="Time zone" Text="{x:Bind ViewModel.TimeZone, Mode=TwoWay}" />
        <StackPanel Orientation="Horizontal" Spacing="12">
            <NumberBox Header="Latitude" Value="{x:Bind ViewModel.Latitude, Mode=TwoWay}" Width="160" />
            <NumberBox Header="Longitude" Value="{x:Bind ViewModel.Longitude, Mode=TwoWay}" Width="160" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Save site" Command="{x:Bind ViewModel.SaveSiteCommand}" />
            <Button Content="Generate enrollment token" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.GenerateTokenCommand}" />
        </StackPanel>
        <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}" Foreground="{StaticResource HealthRed}" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Opacity="0.8"
                   Text="Run this on the site's scale PC as an administrator. The token works once, within 24 hours, and is not shown again." />
        <TextBox Header="Install command" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                 Text="{x:Bind ViewModel.Token.InstallCommand, Mode=OneWay, FallbackValue=''}" />
        <Button Content="Copy" Click="OnCopy" />
    </StackPanel>
</Page>
