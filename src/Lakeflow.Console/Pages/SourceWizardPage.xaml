<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Lakeflow.Console.Pages.SourceWizardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lakeflow.Console"
    xmlns:vm="using:Lakeflow.Console.Core.ViewModels">
    <ScrollViewer>
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
            <TextBlock Text="Add a source" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Show(ViewModel.IsBusy), Mode=OneWay}" />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Errors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Text="{x:Bind}" Foreground="{StaticResource HealthRed}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 1. Which system -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.StepIs(ViewModel.Step, 'Source'), Mode=OneWay}">
                <TextBlock Text="1. Which system" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox x:Name="EngineBox" Header="Engine" ItemsSource="{x:Bind ViewModel.Engines}" DisplayMemberPath="Name"
                          SelectionChanged="OnEngine" SelectedIndex="0" Width="420" />
                <TextBox Header="Source id (unique at this site, e.g. compuweigh)" Text="{x:Bind ViewModel.SourceId, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                <TextBox Header="Source system (shared by every site; names the silver tables)" Text="{x:Bind ViewModel.SourceSystem, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                <ComboBox x:Name="DivisionBox" Header="Division (decides the Event Hub)" ItemsSource="{x:Bind ViewModel.Divisions}"
                          SelectionChanged="OnDivision" SelectedIndex="0" Width="420" />
                <Button Content="Next" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.NextCommand}" />
            </StackPanel>

            <!-- 2. Connection -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.StepIs(ViewModel.Step, 'Connection'), Mode=OneWay}">
                <TextBlock Text="2. Connection (as seen from the scale PC)" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBox Header="Host" Text="{x:Bind ViewModel.Host, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                <TextBox Header="Instance name (optional)" Text="{x:Bind ViewModel.Instance, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                <TextBox Header="Database" Text="{x:Bind ViewModel.Database, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                <ComboBox x:Name="AuthBox" Header="Sign in with" SelectionChanged="OnAuth" SelectedIndex="0" Width="420">
                    <x:String>SQL login (read-only)</x:String>
                    <x:String>The agent's Windows service account</x:String>
                </ComboBox>
                <TextBox Header="User name" Text="{x:Bind ViewModel.UserName, Mode=TwoWay}" Width="420" HorizontalAlignment="Left" />
                <PasswordBox x:Name="PasswordBox" Header="Password (sealed to the agent; never stored by the console or the API)"
                             PasswordChanged="OnPassword" Width="420" HorizontalAlignment="Left" />
                <CheckBox Content="Trust the server's certificate (vendor servers with a self-signed certificate)"
                          IsChecked="{x:Bind ViewModel.TrustServerCertificate, Mode=TwoWay}" />
                <NumberBox Header="Most rows read per second" Value="{x:Bind ViewModel.MaxRowsPerSecond, Mode=TwoWay}" Minimum="10" Width="220" HorizontalAlignment="Left" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
                    <Button Content="Test connection" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.TestConnectionCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 3. Tables -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.StepIs(ViewModel.Step, 'Tables'), Mode=OneWay}">
                <TextBlock Text="3. Tables to capture" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8"
                           Text="Only methods that need nothing changed on the source are offered. Change Tracking appears when the database owner has already enabled it." />
                <ListView ItemsSource="{x:Bind ViewModel.Tables}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TableChoice">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="200" /><ColumnDefinition Width="140" /><ColumnDefinition Width="2*" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}" MinWidth="0" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Table}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Rows}" VerticalAlignment="Center" />
                                <ComboBox Grid.Column="3" ItemsSource="{x:Bind Methods}" SelectedItem="{x:Bind MethodItem, Mode=TwoWay}" PlaceholderText="Method" />
                                <TextBox Grid.Column="4" Text="{x:Bind Watermark, Mode=TwoWay}" PlaceholderText="Watermark column" />
                                <TextBlock Grid.Column="5" Text="{x:Bind Note}" TextWrapping="Wrap" Opacity="0.8" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Back" Command="{x:Bind ViewModel.BackCommand}" />
                    <Button Content="Save and start snapshot" Style="{StaticResource AccentButtonStyle}" Command="{x:Bind ViewModel.FinishCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Done -->
            <StackPanel Spacing="12" Visibility="{x:Bind local:Ui.StepIs(ViewModel.Step, 'Done'), Mode=OneWay}">
                <TextBlock Text="Done" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Button Content="Back to the site" Click="OnDone" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
