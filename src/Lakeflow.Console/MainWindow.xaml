<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Lakeflow.Console.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Lakeflow.Console"
    Title="Lakeflow Console">
    <Grid>
        <!-- Signed out -->
        <StackPanel x:Name="SignInPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="420">
            <TextBlock Text="Lakeflow Console" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock TextWrapping="Wrap" Text="Sign in with your Mercer Landmark account. Access follows your Lakeflow group (Admin, Operator or Viewer)." />
            <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource AccentButtonStyle}" Click="OnSignIn" />
            <TextBlock x:Name="SignInError" Foreground="{StaticResource HealthRed}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Signed in -->
        <NavigationView x:Name="Nav" Visibility="Collapsed" IsBackButtonVisible="Auto" IsSettingsVisible="False"
                        SelectionChanged="OnNavigate" BackRequested="OnBack" PaneDisplayMode="Left">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Fleet" Tag="fleet" Icon="World" />
                <NavigationViewItem x:Name="EnrollItem" Content="Sites and enrollment" Tag="enroll" Icon="Add" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="UserItem" Icon="Contact" SelectsOnInvoked="False" Tapped="OnSignOut"
                                    ToolTipService.ToolTip="Sign out" />
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Padding="24,12,24,24" />
        </NavigationView>
    </Grid>
</Window>
