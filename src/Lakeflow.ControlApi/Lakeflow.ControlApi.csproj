<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>Lakeflow.ControlApi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Npgsql 8.0.11 is built on EF Core 8.0.11; keep EF on the patched version. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <!-- Reads reconciliation results from the Fabric SQL endpoint. -->
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Novell.Directory.Ldap.NETStandard" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Formatting.Compact" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lakeflow.Contracts\Lakeflow.Contracts.csproj" />
    <ProjectReference Include="..\Lakeflow.Snowflake\Lakeflow.Snowflake.csproj" />
    <!-- The web console, served at /console. -->
    <ProjectReference Include="..\Lakeflow.Console.Web\Lakeflow.Console.Web.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lakeflow.ControlApi.Tests" />
  </ItemGroup>
</Project>
