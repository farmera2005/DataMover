<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <RootNamespace>Lakeflow.Console.Web</RootNamespace>
    <!-- Served by the control API at /console. -->
    <StaticWebAssetBasePath>console</StaticWebAssetBasePath>
    <!-- Generated code from the MVVM toolkit triggers this in Razor projects. -->
    <NoWarn>$(NoWarn);CS1998</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lakeflow.Console.Core\Lakeflow.Console.Core.csproj" />
  </ItemGroup>
</Project>
