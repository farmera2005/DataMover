@inherits LayoutComponentBase
@inject ShellViewModel Shell
@implements IDisposable

@switch (Shell.State)
{
    case ShellState.Loading:
        <p class="loading">Loading the Lakeflow console…</p>
        break;
    case ShellState.Unreachable:
        <div class="centered"><h1>Lakeflow</h1><p class="error">The control API did not answer: @Shell.Error</p><button @onclick="Reload">Try again</button></div>
        break;
    case ShellState.NeedsSetup:
        <SetupWizard />
        break;
    case ShellState.SetupClosed:
        <div class="centered">
            <h1>Lakeflow setup</h1>
            <p>Setup must be finished within an hour of the control API starting, so that nobody else on the network can claim a new installation.</p>
            <p>Restart the <b>api</b> container (from your Docker management tool, or <code>docker compose restart api</code>), then reload this page.</p>
        </div>
        break;
    case ShellState.SignedOut:
        <SignIn />
        break;
    default:
        <header class="top">
            <a class="brand" href="">Lakeflow</a>
            <nav>
                <NavLink href="" Match="NavLinkMatch.All">Fleet</NavLink>
                <NavLink href="alerts">Alerts</NavLink>
                @if (Shell.User?.CanAdminister == true)
                {
                    <NavLink href="config/sites">Configuration</NavLink>
                }
            </nav>
            <span class="user">@(Shell.User?.Name) · @(Shell.User?.Role)</span>
            <button class="link" @onclick="() => Shell.SignOutCommand.ExecuteAsync(null)">Sign out</button>
        </header>
        <main>@Body</main>
        break;
}

@code {
    protected override async Task OnInitializedAsync()
    {
        Shell.PropertyChanged += Changed;
        if (Shell.State == ShellState.Loading) await Shell.InitializeCommand.ExecuteAsync(null);
    }

    private void Changed(object? sender, System.ComponentModel.PropertyChangedEventArgs e) => InvokeAsync(StateHasChanged);

    private Task Reload() => Shell.InitializeCommand.ExecuteAsync(null);

    public void Dispose() => Shell.PropertyChanged -= Changed;
}
